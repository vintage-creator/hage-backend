generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserKind {
  ENTERPRISE
  DISTRIBUTOR
  INDIVIDUAL
  LOGISTIC_SERVICE_PROVIDER
  LAST_MILE_DELIVERY
}

enum CompanyRole {
  CROSS_BORDER_LOGISTICS
  TRANSPORTER
  LAST_MILE_PROVIDER
}

enum DocType {
  COMPANY_REGISTRATION_CERTIFICATE
  TAX_REGISTRATION_CERTIFICATE
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  RESTRICTED
  MAINTENANCE
}

enum InventoryLocationStatus {
  AVAILABLE
  QUARANTINE
  HOLD
  DAMAGED
  RESERVED
}

enum InventoryCondition {
  NEW
  GOOD
  USED
  DAMAGED
  EXPIRED
}

enum ShipmentType {
  INLAND
  CROSS_BORDER
}

enum Visibility {
  PUBLIC
  PRIVATE
  ASSIGNED
}

enum FreightType {
  SEA_FREIGHT
  AIR_FREIGHT
}

enum ShipmentStatus {
  PENDING
  ACCEPTED
  IN_WAREHOUSE
  IN_TRANSIT
  PICKED_UP
  DELIVERED
  COMPLETED
  CANCELLED
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CommunicationThreadStatus {
  ACTIVE
  CLOSED
}

enum CallSessionStatus {
  REQUESTED
  RINGING
  ONGOING
  ENDED
  MISSED
  REJECTED
  CANCELLED
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  WAYBILL
  BILL_OF_LADING
  OTHER
}

enum NotificationType {
  EMAIL
  IN_APP
  SMS
}

enum PaymentMethodType {
  CARD
  LOCAL_BANK
}

enum CardBrand {
  VISA
  MASTERCARD
}

model User {
  id             String    @id @default(cuid())
  email          String?   @unique
  phone          String?   @unique
  password       String?
  profilePicture String?
  kind           UserKind
  companyId      String?
  isVerified     Boolean   @default(false)
  deactivatedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company             Company?             @relation(fields: [companyId], references: [id])
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  refreshTokens       RefreshToken[]
  issues              ReportedIssue[]
  paymentMethods      PaymentMethod[]
  notificationSetting NotificationSetting?
  teamInvitesSent     TeamInvite[]

  createdShipments      Shipment[]              @relation("ShipmentCreator")
  customerShipments     Shipment[]              @relation("CustomerShipments")
  transporterShipments  Shipment[]              @relation("TransporterShipments")
  ShipmentStatusHistory ShipmentStatusHistory[]
  Notification          Notification[]
  inventory             Inventory[]
  bids                  TransporterBid[]        @relation("TransporterBids")
  ratingsReceived       TransporterRating[]     @relation("RatingsReceived")
  ratingsGiven          TransporterRating[]     @relation("RatingsGiven")
  payments              Payment[]
  communicationMessages CommunicationMessage[]
}

model Company {
  id              String       @id @default(cuid())
  fullName        String
  phoneNumber     String
  emailAddress    String       @unique
  businessName    String
  businessAddress String
  country         String?
  language        String?
  role            CompanyRole?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  documents         TrackingDocument[]
  users             User[]
  Warehouse         Warehouse[] // keep relation to warehouses
  InventoryLocation InventoryLocation[]
  slaSettings       SlaSetting[]

  @@index([emailAddress])
}

model TrackingDocument {
  id         String   @id @default(cuid())
  companyId  String
  type       DocType
  url        String
  uploadedAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  userAgent String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SlaSetting {
  id                          String   @id @default(cuid())
  companyId                   String
  companyName                 String
  deliveryTimeCommitment      String
  routeFrom                   String
  routeTo                     String
  vehicleType                 String
  onTimeDeliveryTargetValue   Float
  onTimeDeliveryThresholdType String
  statePenalty                String
  stateIncentive              String
  validityStartDate           DateTime
  validityEndDate             DateTime
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ReportedIssue {
  id        String   @id @default(cuid())
  userId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PaymentMethod {
  id                 String            @id @default(cuid())
  userId             String
  type               PaymentMethodType
  cardholderName     String?
  cardBrand          CardBrand?
  cardLast4          String?
  expiration         String?
  postalCode         String?
  bankName           String?
  accountName        String?
  accountNumberLast4 String?
  bankSortCode       String?
  currency           String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NotificationSetting {
  id                     String   @id @default(cuid())
  userId                 String   @unique
  realTimeShipmentStatus Boolean  @default(true)
  messaging              Boolean  @default(true)
  escalationsOrDispute   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamInvite {
  id          String   @id @default(cuid())
  invitedById String
  companyId   String?
  email       String
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  invitedBy User @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([invitedById])
  @@index([companyId])
}

model Warehouse {
  id            String          @id @default(cuid())
  companyId     String
  name          String
  country       String
  city          String
  address       String
  totalCapacity Int // capacity measured in "capacityUnit"
  capacityUnit  String          @default("pieces")
  status        WarehouseStatus @default(ACTIVE)

  numZones       Int?
  numRows        Int?
  numRacks       Int?
  numBinsPerRack Int?

  allowsNone        Boolean @default(false)
  allowsTemperature Boolean @default(false)
  allowsHazardous   Boolean @default(false)
  allowsQuarantine  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  zones     Zone[]
  Inventory Inventory[]

  shipments Shipment[] @relation("WarehouseShipments")

  @@index([companyId])
}

model Zone {
  id               String   @id @default(cuid())
  warehouseId      String
  name             String
  tempMin          Float? // nullable temperature range (capability)
  tempMax          Float?
  allowsHazardous  Boolean  @default(false)
  isQuarantineZone Boolean  @default(false)
  capacity         Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  warehouse Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  racks     Rack[]
  shipments Shipment[]

  @@index([warehouseId])
}

model Rack {
  id        String   @id @default(cuid())
  zoneId    String
  name      String
  capacity  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zone      Zone       @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  bins      Bin[]
  shipments Shipment[]

  @@index([zoneId])
}

model Bin {
  id              String   @id @default(cuid())
  rackId          String
  name            String
  capacity        Int // capacity in same unit as warehouse
  currentQty      Int      @default(0) // actual stored qty
  reservedQty     Int      @default(0) // sum of active reservations
  tempMin         Float?
  tempMax         Float?
  allowsHazardous Boolean  @default(false)
  isQuarantine    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rack               Rack                @relation(fields: [rackId], references: [id], onDelete: Cascade)
  InventoryLocations InventoryLocation[]
  shipments          Shipment[]

  @@index([rackId])
  @@index([currentQty, reservedQty])
}

/**
 * --- Product / Inventory models ---
 */
model Product {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  unit        String   @default("pieces")
  tempMin     Float?
  tempMax     Float?
  isHazardous Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Inventory {
  id              String   @id @default(cuid())
  shipmentId      String
  warehouseId     String
  clientName      String?
  rackId          String?
  binId           String?
  zoneId          String?
  status          String?
  condition       String?
  specialHandling String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  // shipment        Shipment    @relation(fields: [shipmentId], references: [orderId])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  locations InventoryLocation[]
  User      User?               @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([shipmentId, warehouseId], name: "product_warehouse_unique")
  @@index([warehouseId])
  @@index([rackId])
  @@index([binId])
}

model InventoryLocation {
  id          String @id @default(cuid())
  inventoryId String
  binId       String
  qty         Int

  // provenance / UI fields
  shipmentId String? // external shipment id (optional)
  clientId   String? // optional FK to Company
  clientName String? // denormalized snapshot of client name

  // per-location metadata
  status          InventoryLocationStatus @default(AVAILABLE)
  condition       InventoryCondition?
  lotNumber       String? // optional batch/lot
  expiryDate      DateTime? // optional expiry
  specialHandling Json? // e.g., { tempMin: 2, tempMax: 8, isHazardous: true, compatibility: ["food","pharma"] }

  // denormalized fields for fast filtering/searching (kept in schema but should be derived from specialHandling)
  tempMin           Float?
  tempMax           Float?
  isHazardous       Boolean? @default(false)
  itemCompatibility String[] @default([])

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  bin       Bin       @relation(fields: [binId], references: [id], onDelete: Cascade)
  Company   Company?  @relation(fields: [companyId], references: [id])
  companyId String?

  // indexing for fast UI filters
  @@index([binId])
  @@index([clientId])
  @@index([shipmentId])
  @@index([status])
}

model Shipment {
  id      String @id @default(uuid())
  orderId String @unique // e.g. SHP-2025-00001

  // SHIPMENT TYPE & VISIBILITY
  shipmentType ShipmentType @default(INLAND)
  visibility   Visibility   @default(PUBLIC)
  freightType  FreightType? // cross-border only

  // CLIENT DETAILS
  clientName String
  email      String?
  phone      String?

  // CARGO DETAILS
  cargoType            String
  tons                 Float   @default(0)
  weight               Float   @default(0)
  handlingInstructions String?
  specialHandling      String?
  itemCompactibility   String?

  // INLAND-SPECIFIC
  truckType String? // e.g. Tipper, Flatbed
  truckSize String? // e.g. 20 Tons

  // CROSS-BORDER SPECIFIC
  destinationCountry String?
  customDocumentUrls String[] @default([])
  cargoDuty          Float?

  // ITEM & CUSTOMER DETAILS
  nameOfItem     String?
  customerName   String?
  customerPhone  String?
  additionalNote String?

  // ORIGIN & DESTINATION (JSON format)
  origin      Json // {country, region, state, lga, address}
  destination Json

  // PICKUP & DELIVERY
  pickupMode          String
  pickupDate          DateTime?
  pickupTimeslot      String?
  bookingOfficerPhone String?
  waybillUrl          String?
  deliveryDate        DateTime?
  orderNumber         String?

  // SERVICE & PRICING
  serviceType    String
  baseFrieght    Float  @default(0)
  handlingFee    Float  @default(0)
  insuranceFee   Float?
  transactionFee Float  @default(0)
  totalCost      Float  @default(0)

  // STATUS & ASSIGNMENT
  status                ShipmentStatus @default(PENDING)
  assignedTransporterId String?
  assignedWarehouseId   String?
  assignedZoneId        String?
  assignedRackId        String?
  assignedBinId         String?

  // TRACKING
  createdBy  String
  customerId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // RELATIONS
  creator     User       @relation("ShipmentCreator", fields: [createdBy], references: [id])
  customer    User       @relation("CustomerShipments", fields: [customerId], references: [id])
  transporter User?      @relation("TransporterShipments", fields: [assignedTransporterId], references: [id])
  warehouse   Warehouse? @relation("WarehouseShipments", fields: [assignedWarehouseId], references: [id])
  zone        Zone?      @relation(fields: [assignedZoneId], references: [id])
  rack        Rack?      @relation(fields: [assignedRackId], references: [id])
  bin         Bin?       @relation(fields: [assignedBinId], references: [id])

  documents           ShipmentDocument[]
  statusHistory       ShipmentStatusHistory[]
  events              TrackingEvent[]
  bids                TransporterBid[]
  payment             Payment?
  communicationThread CommunicationThread?

  @@index([orderId])
  @@index([status])
  @@index([customerId])
  @@index([createdBy])
  @@index([shipmentType])
  @@index([visibility])
  @@index([assignedWarehouseId])
  @@index([assignedZoneId])
  @@index([assignedRackId])
  @@index([assignedBinId])
}

model ShipmentDocument {
  id         String       @id @default(uuid())
  shipmentId String
  docType    DocumentType
  url        String
  uploadedAt DateTime     @default(now())
  fileName   String?

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model ShipmentStatusHistory {
  id         String         @id @default(uuid())
  shipmentId String
  status     ShipmentStatus
  note       String?
  updatedBy  String
  timestamp  DateTime       @default(now())

  shipment      Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  updatedByUser User     @relation(fields: [updatedBy], references: [id])

  @@index([shipmentId])
  @@index([timestamp])
}

model TrackingEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     String
  location   String?
  note       String?
  timestamp  DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

model CommunicationThread {
  id                String                    @id @default(cuid())
  shipmentId        String                    @unique
  enterpriseUserId  String
  transporterUserId String
  status            CommunicationThreadStatus @default(ACTIVE)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  shipment Shipment               @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  messages CommunicationMessage[]
  calls    CallSession[]

  @@index([enterpriseUserId])
  @@index([transporterUserId])
}

model CommunicationMessage {
  id        String    @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User                @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model CallSession {
  id             String            @id @default(cuid())
  threadId       String
  shipmentId     String
  initiatedById  String
  recipientId    String
  status         CallSessionStatus @default(REQUESTED)
  provider       String            @default("IN_APP")
  providerCallId String?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  thread CommunicationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([shipmentId])
  @@index([initiatedById])
  @@index([recipientId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
}

model MarketplaceWaitlist {
  id        String   @id @default(uuid())
  fullName  String
  email     String   @unique
  country   String
  industry  String
  createdAt DateTime @default(now())
}

model TransporterBid {
  id            String    @id @default(cuid())
  shipmentId    String
  transporterId String
  price         Float
  status        BidStatus @default(PENDING)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  transporter User     @relation("TransporterBids", fields: [transporterId], references: [id])

  @@unique([shipmentId, transporterId])
  @@index([shipmentId])
  @@index([transporterId])
  @@index([status])
}

model TransporterRating {
  id            String   @id @default(cuid())
  transporterId String
  ratedById     String
  shipmentId    String?
  rating        Int // 1–5
  comment       String?
  createdAt     DateTime @default(now())

  transporter User @relation("RatingsReceived", fields: [transporterId], references: [id])
  ratedBy     User @relation("RatingsGiven", fields: [ratedById], references: [id])

  @@index([transporterId])
  @@index([ratedById])
  @@index([shipmentId])
}

model Payment {
  id         String    @id @default(cuid())
  shipmentId String    @unique
  userId     String
  amount     Float
  currency   String    @default("NGN")
  provider   String    @default("PAYSTACK")
  reference  String    @unique
  status     String    @default("PENDING")
  metadata   Json?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([reference])
  @@index([status])
}
